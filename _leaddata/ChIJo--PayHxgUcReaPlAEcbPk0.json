            "profile_photo_url" : "https://lh3.googleusercontent.com/a-/ALV-UjUp4mhRhfZGYjLyRns-9Y60-khRoegdi-vSJFDABe60KK5GAthm0g=s128-c0x00000000-cc-rp-mo-ba5",
            "rating" : 5,
            "relative_time_description" : "2 mesi fa",
            "text" : "Locale scelto per caso, dopo un trekking di 7 ore. Servizio impeccabile. Cordiali e simpatici. Ottime tutte le portate scelte.\nCe lo ricorderemo!",
            "time" : 1777700693,
